#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MONOREPO="$(cd "$ROOT/.." && pwd)"

PYTHONPATH="$ROOT/src:$MONOREPO/nora-specification/src:$MONOREPO/nora-connectors/src:$MONOREPO/nora-evidence/src:$MONOREPO/nora-retrieval/src:$MONOREPO/nora-basis/src:$MONOREPO/nora-legal-research/src:$MONOREPO/nora-capabilities/src:$MONOREPO/nora-conformance/src:$MONOREPO/nora-capsules/src:$MONOREPO/nora-jurisdiction-packs/src:$MONOREPO/nora-evals/src:$MONOREPO/nora-orchestrator/src:$MONOREPO/nora-cli/src:${PYTHONPATH:-}" exec python3 -m nora_devstack.cli "$@"
