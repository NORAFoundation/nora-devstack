#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-doctor}"
case "$cmd" in
  doctor) echo "NORA devstack scaffold: synthetic-only; production endpoints prohibited" ;;
  up) docker compose -f "$ROOT/compose/docker-compose.yml" up -d ;;
  down) docker compose -f "$ROOT/compose/docker-compose.yml" down ;;
  reset) docker compose -f "$ROOT/compose/docker-compose.yml" down -v ;;
  *) echo "usage: nora-dev {doctor|up|down|reset}" >&2; exit 2 ;;
esac
